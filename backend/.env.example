# Copy to .env and fill in for local dev. Never commit the real .env file.

ENVIRONMENT=development

# Postgres (used when Docker/Postgres is available). Leave unset to fall back to local SQLite.
# DATABASE_URL=postgresql+asyncpg://careeros:careeros_dev_password@localhost:5432/careeros

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional integrations — leave blank to run with mock providers (see ARCHITECTURE.md)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
ADMOB_APP_ID=
REDIS_URL=

# Phase 8 — Smart Recruitment Email Tracking (see ARCHITECTURE.md / DEPLOYMENT.md / PRIVACY.md).
# Leave every one of these blank to run fully on the mock provider — the feature stays usable
# with Manual Tracking regardless. A provider only becomes "available" when its flag is true AND
# its credentials below are all present (see Settings.gmail_tracking_available/outlook_tracking_available).
EMAIL_TRACKING_ENABLED=true
GMAIL_TRACKING_ENABLED=true
OUTLOOK_TRACKING_ENABLED=true
FORWARD_EMAIL_ENABLED=false

# Google Cloud project OAuth client (Gmail read-only tracking) — see DEPLOYMENT.md for the full
# Google Cloud / Pub/Sub setup this requires before it can be used for real.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PUBSUB_TOPIC=

# Microsoft Entra app registration (Outlook/Microsoft 365 delegated Mail.Read tracking).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=
MICROSOFT_WEBHOOK_URL=
MICROSOFT_LIFECYCLE_WEBHOOK_URL=

# Domain used to build each user's non-guessable "Forward to CareerOS" alias
# (apply+<opaque-token>@<this domain>) — architecture only until an inbound-mail provider is
# configured (FORWARD_EMAIL_ENABLED stays false until then).
FORWARD_EMAIL_DOMAIN=mail.careeros.app

# Fernet key(s) used to encrypt OAuth tokens at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys (newest first) to rotate without breaking old ciphertexts.
# NEVER reuse the checked-in dev default below in production.
TOKEN_ENCRYPTION_KEYS=UuQmhsXcogUgfZv-VKXGPr1jS2C5Y0EIytlAc77syfg=

# First-run only: creates one SUPER_ADMIN with these credentials at startup if no admin_users
# row exists yet. Leave blank after your first admin account is created.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
